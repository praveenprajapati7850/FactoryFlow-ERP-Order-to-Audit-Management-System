# =============================================================================
# FactoryFlow ERP — Google Cloud SQL (PostgreSQL) & Server Environment Template
# Copy to .env for local development. Never commit real credentials or secrets.
# In Google Cloud Run, store SQL_PASSWORD and JWT_SECRET in Google Secret Manager.
# =============================================================================

# --- Google Cloud SQL (PostgreSQL) Connection (Object Method — DO NOT use DATABASE_URL) ---
# Local via Cloud SQL Auth Proxy: SQL_HOST="127.0.0.1", SQL_PORT="5432"
# Cloud Run via Unix Socket: leave SQL_HOST empty and set INSTANCE_CONNECTION_NAME
#   (automatically resolves to /cloudsql/<INSTANCE_CONNECTION_NAME>)
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_DATABASE="factoryflow"
# Optional alias used by AI Studio managed Cloud SQL environments (takes precedence if set)
# SQL_DB_NAME="factoryflow"
SQL_USER="factoryflow_app"
SQL_PASSWORD="CHANGE_ME_STRONG_APP_DB_PASSWORD"
INSTANCE_CONNECTION_NAME=""

# --- PostgreSQL / Cloud SQL Admin Credentials (Drizzle Kit schema migrations only) ---
SQL_ADMIN_USER="factoryflow_admin"
SQL_ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_DB_PASSWORD"

# --- Optional Connection Pool & TLS Tuning ---
# SQL_POOL_MAX="10"
# SQL_SSL="false"

# --- Authentication Security (REQUIRED — minimum 32 random characters; server fails fast if weak) ---
# Generate with: openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX_FROM_OPENSSL_RAND_HEX_32"

# --- Application Runtime & Origin / Cookie Security ---
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"
# Comma-separated trusted HTTPS origins for strict Origin/Referer CSRF validation (e.g. Cloud Run + custom domain)
# ALLOWED_ORIGINS="https://factoryflow-erp.example.com"
# Cookie SameSite policy on HTTPS: "lax" (default for standalone Cloud Run), "strict", or "none" (only for cross-site iframes)
# COOKIE_SAME_SITE="lax"

# --- Optional AI / Platform Keys ---
GEMINI_API_KEY=""
